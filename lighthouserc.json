{
  "ci": {
    "collect": {
      "startServerCommand": "node scripts/serve-dist.mjs",
      "startServerReadyPattern": "serving dist on",
      "url": [
        "http://localhost:4173/",
        "http://localhost:4173/services",
        "http://localhost:4173/industries",
        "http://localhost:4173/blog",
        "http://localhost:4173/industries/construction"
      ],
      "numberOfRuns": 3,
      "settings": {
        "preset": "desktop",
        "throttlingMethod": "simulate",
        "skipAudits": ["color-contrast"]
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": ["error", { "minScore": 0.95 }],
        "categories:accessibility": ["error", { "minScore": 1 }],
        "categories:best-practices": ["warn", { "minScore": 0.95 }],
        "categories:seo": ["error", { "minScore": 0.95 }],

        "largest-contentful-paint": ["error", { "maxNumericValue": 2000 }],
        "cumulative-layout-shift": ["error", { "maxNumericValue": 0.05 }],
        "total-blocking-time": ["error", { "maxNumericValue": 200 }],

        "errors-in-console": "error",
        "unsized-images": "error"
      }
    },
    "upload": { "target": "temporary-public-storage" }
  }
}
